---
import '../styles/global.css';
interface Props { title: string; description?: string }
const { title, description = 'Recognize and find cards from Yu-Gi-Oh! The Duelists of the Roses.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} /><title>{title} · Rose Codex</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header"><div class="app-container header-inner">
      <a class="brand" href="/"><svg class="brand-mark" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m12 2 8 5v10l-8 5-8-5V7Z" stroke="currentColor" stroke-width="1.5"/><path d="m12 6 5 3v6l-5 3-5-3V9Zm0 4 2 1v2l-2 1-2-1v-2Z" stroke="currentColor" stroke-width="1.5"/></svg>Rose <span>Codex</span></a>
      <nav class="site-nav" aria-label="Main navigation">
        <a href="/cards/" aria-current={Astro.url.pathname === '/' || Astro.url.pathname.startsWith('/cards') ? 'page' : undefined}>Cards</a>
        <a href="/fusion/" aria-current={Astro.url.pathname.startsWith('/fusion') ? 'page' : undefined}>Fusion</a>
        <a href="/recipes/" aria-current={Astro.url.pathname.startsWith('/recipes') ? 'page' : undefined}>Recipes</a>
        <a href="/decks/" aria-current={Astro.url.pathname.startsWith('/decks') ? 'page' : undefined}>Decks</a>
        <a href="/coach/" aria-current={Astro.url.pathname.startsWith('/coach') ? 'page' : undefined}>Deck Coach</a>
        <a href="/duel/" aria-current={Astro.url.pathname.startsWith('/duel') ? 'page' : undefined}>Duel Coach</a>
        <a href="/leaders/" aria-current={Astro.url.pathname.startsWith('/leaders') ? 'page' : undefined}>Leaders</a>
        <a href="/reincarnation/" aria-current={Astro.url.pathname.startsWith('/reincarnation') ? 'page' : undefined}>Reincarnation</a>
        <a href="/opponents/" aria-current={Astro.url.pathname.startsWith('/opponents') ? 'page' : undefined}>Opponents</a>
        <a href="/saves/" aria-current={Astro.url.pathname.startsWith('/saves') ? 'page' : undefined}>Saves</a>
        <a href="/simulate/" aria-current={Astro.url.pathname.startsWith('/simulate') ? 'page' : undefined}>Simulator</a>
        <a href="/collection/" aria-current={Astro.url.pathname.startsWith('/collection') ? 'page' : undefined}>Collection</a>
      </nav><span class="header-context">THE DUELISTS OF THE ROSES</span>
    </div></header>
    <main id="main" class="app-container site-main"><slot /></main>
    <footer class="site-footer"><div class="app-container">
      <span>Yu-Gi-Oh! The Duelists of the Roses · Unofficial companion</span>
      <a href="https://github.com/wihlarkop/rose-codex/blob/main/docs/card-images.md">Image sources &amp; coverage</a>
    </div></footer>
  </body>
</html>
