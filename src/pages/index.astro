---
import Shell from '../layouts/Shell.astro';
---
<Shell title="Rose Codex">
  <h1>Your DotR card library</h1>
  <p class="muted">Recognize cards while you play The Duelists of the Roses.</p>
  <a class="browse-link" href="/cards/">Browse all 854 cards</a>
</Shell>
<style>.browse-link { display: inline-block; padding: .7rem 1rem; background: var(--control); border: 1px solid var(--line); border-radius: 5px; text-decoration: none; } .browse-link:hover { border-color: var(--accent); }</style>
