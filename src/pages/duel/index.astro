---
import Shell from '../../layouts/Shell.astro';
import DuelCompanion from '../../features/duel/DuelCompanion.svelte';
import cards from '../../../data/canonical/cards.json';
import images from '../../../data/canonical/images.json';
import fusions from '../../../data/canonical/fusions.json';
import { browserCards } from '../../lib/dotr/browser';
import type { Card, FusionData, ImageRecord } from '../../lib/dotr/model';
const canonicalCards = cards as Card[];
const library = browserCards(canonicalCards, images as ImageRecord[]);
const allowedCardIds = canonicalCards.map(card => card.id);
---
<Shell title="Duel Companion">
  <DuelCompanion cards={library} {canonicalCards} fusions={fusions as FusionData} {allowedCardIds} client:load />
</Shell>
