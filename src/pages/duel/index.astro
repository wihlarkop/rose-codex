---
import Shell from '../../layouts/Shell.astro';
import TacticalDuelCoach from '../../components/TacticalDuelCoach.svelte';
import cards from '../../../data/canonical/cards.json';
import images from '../../../data/canonical/images.json';
import fusions from '../../../data/canonical/fusions.json';
import { browserCards } from '../../lib/dotr/browser';
import type { Card, FusionData, ImageRecord } from '../../lib/dotr/model';

const library = browserCards(cards as Card[], images as ImageRecord[]);
---
<Shell title="Tactical Duel Coach">
  <TacticalDuelCoach cards={library} canonicalCards={cards as Card[]} fusions={fusions as FusionData} client:load />
</Shell>
