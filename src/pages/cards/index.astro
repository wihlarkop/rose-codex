---
import Shell from '../../layouts/Shell.astro';
import CardBrowser from '../../components/CardBrowser.svelte';
import cards from '../../../data/canonical/cards.json';
import images from '../../../data/canonical/images.json';
import { browserCards } from '../../lib/dotr/browser';
import type { Card, ImageRecord } from '../../lib/dotr/model';
const library = browserCards(cards as Card[], images as ImageRecord[]);
---
<Shell title="Cards">
  <h1>Card library</h1><p class="muted intro">Find the card you see in The Duelists of the Roses.</p>
  <CardBrowser cards={library} client:load />
</Shell>
<style>.intro { margin-bottom: 0; }</style>
