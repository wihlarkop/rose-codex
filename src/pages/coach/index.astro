---
import Shell from '../../layouts/Shell.astro';
import SmartDeckCoach from '../../components/SmartDeckCoach.svelte';
import cards from '../../../data/canonical/cards.json';
import fusions from '../../../data/canonical/fusions.json';
import { browserCards } from '../../lib/dotr/browser';
import type { Card, FusionData } from '../../lib/dotr/model';
const library = browserCards(cards as Card[]);
---
<Shell title="Smart Deck Coach">
  <SmartDeckCoach cards={cards as Card[]} library={library} fusions={fusions as FusionData} client:load />
</Shell>
