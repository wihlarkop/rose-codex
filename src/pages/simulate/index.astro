---
import Shell from '../../layouts/Shell.astro';
import DeckSimulator from '../../features/decks/DeckSimulator.svelte';
import cards from '../../../data/canonical/cards.json';
import fusions from '../../../data/canonical/fusions.json';
import { browserCards } from '../../lib/dotr/browser';
import type { Card, FusionData } from '../../lib/dotr/model';
const canonicalCards = cards as Card[];
const library = browserCards(canonicalCards);
---
<Shell title="Deck Simulator">
  <DeckSimulator cards={library} canonicalCards={canonicalCards} fusionData={fusions as FusionData} client:load />
</Shell>
