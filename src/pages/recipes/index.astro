---
import Shell from '../../layouts/Shell.astro';
import FusionEncyclopedia from '../../features/fusion/FusionEncyclopedia.svelte';
import cards from '../../../data/canonical/cards.json';
import fusions from '../../../data/canonical/fusions.json';
import { browserCards } from '../../lib/dotr/browser';
import type { Card, FusionData } from '../../lib/dotr/model';
const library = browserCards(cards as Card[]);
---
<Shell title="Fusion Encyclopedia">
  <FusionEncyclopedia cards={library} fusionData={fusions as FusionData} client:load />
</Shell>
