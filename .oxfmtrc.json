{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "tabWidth": 2,
  "printWidth": 100,
  "endOfLine": "lf",
  "sortPackageJson": false,
  "sortImports": false,
  "svelte": { "sortOrder": "none" },
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    ".astro/**",
    ".wrangler/**",
    ".worktrees/**",
    "data/**",
    "public/**",
    "bun.lock",
    "**/*.astro",
    "src/components/**",
    "src/lib/dotr/**",
    "src/styles/**",
    "scripts/data/**",
    "scripts/images/**",
    "tests/**",
    "docs/**",
    "!docs/tooling.md",
    "README.md",
    "PRODUCT.md",
    "DESIGN.md"
  ]
}
